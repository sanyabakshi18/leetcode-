Problem 58. Length of last word 
Solution- 
class Solution {
    public int lengthOfLastWord(String s) {
        int length = 0;
        int i = s.length() - 1;
        // Skip trailing spaces
        while (i >= 0 && s.charAt(i) == ' ') {
            i--;
        }
        // Counting characters of the last word
        while (i >= 0 && s.charAt(i) != ' ') {
            length++;
            i--;
        }
        return length;
    }
}

Problem26. Remove duplicates from sorted array

Solution- class Solution {
    public int removeDuplicates(int[] nums) {
        if (nums.length <= 2) {
            return nums.length;
        }

        int k = 2;

        for (int i = 2; i < nums.length; i++) {
            if (nums[i] != nums[k - 2]) {
                nums[k] = nums[i];
                k++;
            }
        }

        return k;
    }
}
Problem 191- Number of 1 bits
Solution- 
class Solution {
    public int hammingWeight(int n) {
        int count = 0;

        while (n != 0) {
            count += (n & 1);
            n >>>= 1;   // Unsigned right shift
        }

        return count;
    }
}
Problem 206 - Reversed linked list
Solution - class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode prev = null;
        ListNode curr = head;

        while (curr != null) {
            ListNode next = curr.next; // Save next node
            curr.next = prev;          // Reverse pointer
            prev = curr;               // Move prev
            curr = next;               // Move current
        }

        return prev;
    }
}
Problem 561 - Array parition
solution- class Solution {
    public int arrayPairSum(int[] nums) {
        Arrays.sort(nums);

        int sum = 0;

        for (int i = 0; i < nums.length; i += 2) {
            sum += nums[i];
        }

        return sum;
    }
}
Problem 144- Binary Tree Preorder traversal
Solution-
class Solution {
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer> result = new ArrayList<>();
        preorder(root, result);
        return result;
    }

    private void preorder(TreeNode node, List<Integer> result) {
        if (node == null) return;

        result.add(node.val);      // Visit root
        preorder(node.left, result);  // Traverse left
        preorder(node.right, result); // Traverse right
    }
}
Problem 145- Binary tree postorder traversal
Solution -
class Solution {
    public List<Integer> postorderTraversal(TreeNode root) {
        List<Integer> result = new ArrayList<>();
        postorder(root, result);
        return result;
    }

    private void postorder(TreeNode node, List<Integer> result) {
        if (node == null) return;

        postorder(node.left, result);   // Traverse left
        postorder(node.right, result);  // Traverse right
        result.add(node.val);           // Visit root
    }
}
Problem 217- Contains Duplicate
solution - import java.util.HashSet;

class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> set = new HashSet<>();

        for (int num : nums) {
            if (set.contains(num)) {
                return true;
            }
            set.add(num);
        }

        return false;
    }
}
Problem 590- N-ary tree postorder traversal
solution-
class Solution {
    public List<Integer> postorder(Node root) {
        List<Integer> result = new ArrayList<>();

        if (root == null) {
            return result;
        }

        for (Node child : root.children) {
            result.addAll(postorder(child));
        }

        result.add(root.val);

        return result;
    }
}
Problem 225- Implement stack using queues
solution-
class MyStack {

    Queue<Integer> q = new LinkedList<>();

    public MyStack() {
        
    }

    public void push(int x) {
        q.add(x);

        int size = q.size();

        for (int i = 0; i < size - 1; i++) {
            q.add(q.remove());
        }
    }

    public int pop() {
        return q.remove();
    }

    public int top() {
        return q.peek();
    }

    public boolean empty() {
        return q.isEmpty();
    }
}
probelm 3471- Find the largest Almost missing integer 
solution- class Solution {
    public int largestInteger(int[] nums, int k) {
        int n = nums.length;
        int[] count = new int[51];

        // Count in how many windows each number appears
        for (int i = 0; i <= n - k; i++) {
            boolean[] seen = new boolean[51];

            for (int j = i; j < i + k; j++) {
                if (!seen[nums[j]]) {
                    count[nums[j]]++;
                    seen[nums[j]] = true;
                }
            }
        }

        // Find the largest number appearing in exactly one window
        for (int num = 50; num >= 1; num--) {
            if (count[num] == 1) {
                return num;
            }
        }

        return -1;
    }
}
